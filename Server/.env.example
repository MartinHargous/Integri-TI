# Integri-TI - Configuración de Variables de Entorno
# Clave de API para ChatGPT / Modelo Luna
OPENAI_API_KEY=tu_api_key_aqui

# Modelo a utilizar (por defecto: luna)
OPENAI_MODEL=luna

# URL base de la API (compatible con OpenAI, vLLM, Ollama o proveedores externos)
OPENAI_BASE_URL=https://api.openai.com/v1

